{
  "agree_questions": {
    "type": "function",
    "function": {
      "name": "agree_questions",
      "description": "Propose the ordered list of questions this session will settle, one per turn.",
      "parameters": {
        "type": "object",
        "properties": {
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Short unique id, e.g. q1."
                },
                "question": {
                  "type": "string",
                  "description": "The decision to be settled, as a question."
                },
                "why_it_matters": {
                  "type": "string",
                  "description": "What depends on the answer."
                }
              },
              "required": [
                "id",
                "question",
                "why_it_matters"
              ]
            }
          },
          "carry_forward": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            },
            "description": "Up to 5 lines to remember for later questions."
          }
        },
        "required": [
          "questions",
          "carry_forward"
        ]
      }
    }
  },
  "settle": {
    "type": "function",
    "function": {
      "name": "settle",
      "description": "Settle the current question: the decision, the alternatives surveyed, the reasoning.",
      "parameters": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "description": "Id of the current question."
          },
          "alternatives": {
            "type": "array",
            "minItems": 2,
            "description": "One entry for each option the question offers, named by its label, each with a case for and a case against. Also list any other plausible alternative you surveyed, named in words.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "An option's label (A, B, and so on), or a short name in words for another alternative you surveyed. A to H and Other are reserved for options."
                },
                "case_for": {
                  "type": "string",
                  "description": "Strongest case for, citing path:line or URL."
                },
                "case_against": {
                  "type": "string",
                  "description": "Strongest case against, citing path:line or URL. Non-empty."
                },
                "backwards_compatible": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "case_for",
                "case_against",
                "backwards_compatible"
              ]
            }
          },
          "decision": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G",
              "H",
              "Other"
            ],
            "description": "The label of the chosen option (A, B, and so on), or Other when no option fits. Do not name an alternative in words here."
          },
          "other": {
            "type": "object",
            "description": "Required only when decision is Other: the best alternative you found yourself, which is not one of the options. Omit it, or send null, for any other decision.",
            "properties": {
              "summary": {
                "type": "string"
              },
              "case_for": {
                "type": "string"
              },
              "case_against": {
                "type": "string",
                "description": "Strongest case against, citing path:line or URL. Non-empty."
              },
              "backwards_compatible": {
                "type": "boolean"
              }
            },
            "required": [
              "summary",
              "case_for",
              "case_against",
              "backwards_compatible"
            ]
          },
          "reasoning": {
            "type": "string"
          },
          "complexity_justification": {
            "type": "string",
            "description": "Required when the chosen alternative is not backwards compatible."
          },
          "carry_forward": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            },
            "description": "Up to 5 lines to remember for later questions."
          }
        },
        "required": [
          "question_id",
          "alternatives",
          "decision",
          "reasoning",
          "carry_forward"
        ]
      }
    }
  }
}