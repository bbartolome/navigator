{
  "agree_questions": {
    "type": "function",
    "function": {
      "name": "agree_questions",
      "description": "Propose the ordered list of questions this session will settle, one per turn.",
      "parameters": {
        "type": "object",
        "properties": {
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Short unique id, e.g. q1."
                },
                "question": {
                  "type": "string",
                  "description": "The decision to be settled, as a question."
                },
                "why_it_matters": {
                  "type": "string",
                  "description": "What depends on the answer."
                }
              },
              "required": [
                "id",
                "question",
                "why_it_matters"
              ]
            }
          },
          "carry_forward": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            },
            "description": "Up to 5 lines to remember for later questions."
          }
        },
        "required": [
          "questions",
          "carry_forward"
        ]
      }
    }
  },
  "settle": {
    "type": "function",
    "function": {
      "name": "settle",
      "description": "Settle the current question: alternatives surveyed, the decision, the reasoning.",
      "parameters": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "description": "Id of the current question."
          },
          "alternatives": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "case_for": {
                  "type": "string",
                  "description": "Strongest case for, citing path:line or URL."
                },
                "case_against": {
                  "type": "string",
                  "description": "Strongest case against, citing path:line or URL."
                },
                "backwards_compatible": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "case_for",
                "case_against",
                "backwards_compatible"
              ]
            }
          },
          "decision": {
            "type": "string",
            "description": "The `name` of the chosen alternative."
          },
          "reasoning": {
            "type": "string"
          },
          "complexity_justification": {
            "type": "string",
            "description": "Required when the decision is not the simplest backwards-compatible alternative."
          },
          "carry_forward": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            },
            "description": "Up to 5 lines to remember for later questions."
          }
        },
        "required": [
          "question_id",
          "alternatives",
          "decision",
          "reasoning",
          "carry_forward"
        ]
      }
    }
  }
}